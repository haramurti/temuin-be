APP_ENV=development
APP_PORT=8080
# Public base URL used to build upload URLs. For Android emulator use http://10.0.2.2:8080
BASE_URL=http://localhost:8080
CORS_ORIGINS=*

DB_HOST=localhost
DB_PORT=5433
DB_USER=temuin
DB_PASSWORD=temuin
DB_NAME=temuin
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# Generate: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_TTL_HOURS=72

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Optional. Empty = rule-based matching and guided FAQ fallbacks.
SINARCLOUD_API_KEY=
DEEPSEEK_MODEL=deepseek/deepseek-v4-1-flash

AUTO_MIGRATE=true
SEED_DATA=true
